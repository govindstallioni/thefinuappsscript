# Normalize all text files and avoid PR tooling binary misclassification
* text=auto

# Source and config files are always text
*.js text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Common true binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
